{
  "name": "craftcms/commerce-sagepay",
  "description": "Sage Pay (Opayo) integration for Craft Commerce 6.0+",
  "type": "craft-plugin",
  "keywords": [
    "sagepay",
    "sage pay",
    "opayo",
    "commerce",
    "craftcms"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Pixel & Tonic",
      "homepage": "https://pixelandtonic.com/"
    }
  ],
  "support": {
    "email": "support@craftcms.com",
    "issues": "https://github.com/craftcms/commerce-sagepay/issues?state=open",
    "source": "https://github.com/craftcms/commerce-sagepay",
    "docs": "https://github.com/craftcms/commerce-sagepay",
    "rss": "https://github.com/craftcms/commerce-sagepay/commits/6.x.atom"
  },
  "require": {
    "php": "^8.5",
    "ext-simplexml": "*",
    "craftcms/commerce": "6.x-dev"
  },
  "require-dev": {
    "craftcms/ecs": "dev-main",
    "larastan/larastan": "^3.4",
    "orchestra/testbench": "^11.0",
    "pestphp/pest": "^4.0",
    "pestphp/pest-plugin-laravel": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "CraftCms\\CommerceSagePay\\": "src/",
      "craft\\commerce\\sagepay\\": "legacy/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CraftCms\\CommerceSagePay\\Tests\\": "tests/"
    }
  },
  "extra": {
    "name": "Sage Pay for Craft Commerce",
    "handle": "commerce-sagepay",
    "developer": "Pixel & Tonic",
    "documentationUrl": "https://github.com/craftcms/commerce-sagepay/blob/6.x/README.md",
    "class": "CraftCms\\CommerceSagePay\\Plugin"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "check-cs": "ecs check --ansi",
    "fix-cs": "ecs check --ansi --fix",
    "phpstan": "phpstan --memory-limit=1G",
    "test": "pest"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "craftcms/plugin-installer": true,
      "pestphp/pest-plugin": true,
      "php-http/discovery": true,
      "yiisoft/yii2-composer": true
    }
  }
}
